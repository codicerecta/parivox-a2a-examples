# Copy to .env for local development. .env is gitignored; never commit real values.

# Auth. Set A2A_API_KEY for anything reachable by another machine.
# A2A_API_KEY=choose-a-long-random-string
A2A_ALLOW_ANONYMOUS=1

# Listen port.
PORT=8080

# The RPC endpoint advertised in the Agent Card. In a VPC deployment this is the
# private DNS name; locally the default is fine.
# PUBLIC_URL=http://localhost:8080/

# Live web research. Without a key the agent serves deterministic canned content
# and still exercises the full protocol.
# OPENAI_API_KEY=
# RESEARCH_MODEL=gpt-4.1
# RESEARCH_MAX_SOURCES=8
