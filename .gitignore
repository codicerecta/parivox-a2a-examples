# Secrets — never commit. Patterns are deliberately broad: a single committed
# credential forces a history rewrite, which is the one irreversible mistake
# this repository can make. Verify additions with `git check-ignore -v <file>`.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials
credentials.json
secrets.json
samconfig.toml
samconfig.yaml
samconfig.yml

# Python
__pycache__/
*.py[cod]
*.egg-info/
# Suffixed too (.venv-test, .venv313): a bare `.venv/` matches by exact name,
# and this repo is meant to go public, so a stray virtualenv is a real hazard.
.venv*/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# AWS SAM / CloudFormation build output
.aws-sam/
packaged.yaml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
